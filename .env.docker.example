# Variables de docker-compose.yml. Genera .env.docker con contraseñas aleatorias (Windows, macOS y Linux):
#   npm run docker:env
#   docker compose --env-file .env.docker up -d --build
# O cópialo a mano y ajusta los valores. No lo subas a git (.env.docker está en .gitignore).

# Contraseña del usuario "storego" de MySQL (obligatoria).
STOREGO_DB_PASSWORD=
# Firma las sesiones JWT (obligatoria; larga y aleatoria, p. ej. `openssl rand -hex 32`).
STOREGO_JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Opcionales
STOREGO_PORT=8080
# Cantidad de réplicas de la API detrás del balanceador.
STOREGO_REPLICAS=2
# Imagen a ejecutar. En CI es storego:<sha> o ghcr.io/<owner>/<repo>:<sha>.
STOREGO_IMAGE=storego:local
